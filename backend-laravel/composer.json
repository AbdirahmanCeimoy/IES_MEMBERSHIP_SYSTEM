{
    "name": "ies/backend-laravel",
    "type": "project",
    "description": "Laravel 12 auth migration for the IES backend.",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "firebase/php-jwt": "^7.0",
        "laravel/framework": "^12.0",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
