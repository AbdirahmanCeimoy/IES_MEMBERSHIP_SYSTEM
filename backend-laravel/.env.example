APP_NAME=IES
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_SKIP_RUNTIME_VALIDATION=false

APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=file
MEMBERSHIP_DOCUMENTS_ROOT=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ies_laravel
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=replace-with-at-least-32-characters-secret
JWT_EXPIRES_IN=1d

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="IES Membership <youraccount@gmail.com>"
SMTP_REPLY_TO=membership@ies.so
SMTP_AUDIT_BCC=archive@ies.so
MAIL_BRAND_LOGO_URL=
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_ALLOW_SELF_SIGNED=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
MAIL_EHLO_DOMAIN=api.example.com
