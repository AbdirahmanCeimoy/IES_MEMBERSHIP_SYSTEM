APP_NAME=IES
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_SKIP_RUNTIME_VALIDATION=false

APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=info

CACHE_STORE=database
CACHE_TABLE=cache
CACHE_LOCK_TABLE=cache_locks
MEMBERSHIP_DOCUMENTS_ROOT=/srv/ies-data/membership-documents

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ies_laravel
DB_USERNAME=ies_user
DB_PASSWORD=replace-with-strong-password

JWT_SECRET=use-the-exact-same-value-as-the-old-backend
JWT_EXPIRES_IN=1d

CORS_ORIGINS=https://www.example.com,https://example.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="IES Membership <youraccount@gmail.com>"
SMTP_REPLY_TO=membership@ies.so
SMTP_AUDIT_BCC=archive@ies.so
MAIL_BRAND_LOGO_URL=
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_ALLOW_SELF_SIGNED=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
MAIL_EHLO_DOMAIN=api.example.com
